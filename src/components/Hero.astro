---
import { Rocket, Bell } from "@lucide/astro";
---

<!-- Hero Section -->
<section class="hero min-h-screen bg-base-200">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <div class="mb-5">
        <Rocket class="w-16 h-16 mx-auto text-primary" />
      </div>
      <h1 class="text-5xl font-bold text-base-content">Aregimplex</h1>
      <p class="py-6 text-base-content">
        Something amazing is coming soon. We're working hard to bring you an
        extraordinary experience.
      </p>
      <button class="btn btn-primary">
        <Bell class="w-5 h-5" />
        Get Notified
      </button>
    </div>
  </div>
</section>
